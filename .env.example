# Copy this to .env.local and fill in your values

# Supabase / Neon / Railway PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Upstash Redis (get from upstash.com)
# If you don't have Redis, set USE_REDIS=false for DB-based locking fallback
REDIS_URL="rediss://default:PASSWORD@HOST:PORT"
USE_REDIS="true"

# Reservation window in minutes (default: 10)
RESERVATION_MINUTES="10"

# Vercel Cron secret (set in Vercel dashboard)
CRON_SECRET="your-cron-secret-here"
